# Generated pipeline output — regenerate via `python -m fantasydrafter`
# (or the individual bin/ scripts). Not committed since it's derived data
# that changes every time the pipeline is rerun.
fantasydrafter/lib/*.csv
.venv
/package-lock.json

# Python bytecode cache
__pycache__/
*.pyc

# ESPN auth cookies (SWID/espn_s2) and any other local-only secrets —
# never commit these. See PROJECTNOTES.md "Auth handling note".
*.local.json
espn_credentials*
